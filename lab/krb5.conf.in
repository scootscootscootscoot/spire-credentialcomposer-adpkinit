# Lab Kerberos config for the NTAuth chaining experiment. Pins the KDC by
# address so no host DNS or /etc/krb5.conf changes are needed — invoke with
# KRB5_CONFIG=lab/krb5.conf. See lab/README.md, "Topology".
#
# pkinit_anchors is the lab root (R) from lab/02-make-ca-chain.sh, not an
# intermediate — that root/issuer distinction is the client-side mirror of
# the exact NTAuth question this lab exists to answer on the KDC side.
#
# pkinit_pool carries both intermediates (I1, I2) purely so the client can
# complete its OWN leaf-cert chain (leaf -> intermediate -> root) before
# sending the AS-REQ. This is unrelated to the NTAuth question — it is a
# local, client-side prerequisite that must hold for every row regardless of
# what NTAuth contains, same spirit as "the other control" in README.md.
# Without it, kinit fails at "Failed to verify own certificate (depth 0):
# unable to get local issuer certificate" before the request ever reaches
# the KDC.
#
# pkinit_kdc_hostname is the second client-side prerequisite of the same
# kind. RFC 4556 has the client validate the KDC's own certificate by
# looking for an id-pkinit-san otherName (1.3.6.1.5.2.2) carrying
# krbtgt/REALM@REALM. Our KDC cert is openssl-built and carries a plain
# dNSName SAN instead (lab/README.md, "Topology" — a real ADCS "Kerberos
# Authentication" template emits both). MIT krb5 only accepts a dNSName SAN
# when told which hostname to match, via this option; without it the client
# reports "found 1 SANs (0 princs, 0 UPNs, 0 DNS names)" and fails with
# "KDC name mismatch" AFTER the KDC has already accepted the client and
# issued the AS-REP — which makes it look like a KDC-side rejection when it
# is entirely client-side. Unrelated to NTAuth; must hold for every row.

[libdefaults]
	default_realm = PKINITLAB.INTERNAL
	dns_lookup_kdc = false
	dns_lookup_realm = false
	rdns = false

[realms]
	PKINITLAB.INTERNAL = {
		kdc = 192.168.122.10
		admin_server = 192.168.122.10
		pkinit_anchors = FILE:/home/labop/vms/pki/root/root-ca.crt
		pkinit_pool = FILE:/home/labop/vms/pki/intermediate1/i1.crt
		pkinit_pool = FILE:/home/labop/vms/pki/intermediate2/i2.crt
		pkinit_kdc_hostname = dc01.pkinitlab.internal
	}

[domain_realm]
	.pkinitlab.internal = PKINITLAB.INTERNAL
	pkinitlab.internal = PKINITLAB.INTERNAL
