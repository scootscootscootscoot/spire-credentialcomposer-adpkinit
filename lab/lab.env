# Shared constants for the phase-4 lab. Sourced by the lab/ scripts.
#
# The domain is deliberately synthetic and uses .internal, which ICANN reserved
# for private use in 2024. Nothing here may ever reference a real forest.

LAB_DOMAIN="pkinitlab.internal"
LAB_REALM="PKINITLAB.INTERNAL"
LAB_NETBIOS="PKINITLAB"

DC_NAME="dc01"
DC_FQDN="dc01.pkinitlab.internal"
DC_IP="192.168.122.10"
DC_MAC="52:54:00:11:22:33"

VM_NAME="pkinit-dc01"
VM_VCPUS="4"
VM_MEMORY_MB="4096"
VM_DISK_GB="60"

# libvirt's default pool. Readable by libvirt-qemu; writable by the lab
# operator after 00-host-setup.sh sets the ACL.
POOL_DIR="/var/lib/libvirt/images"

# Where the downloads land before being staged into the pool.
DOWNLOAD_DIR="${HOME}/vms/iso"

WINDOWS_ISO="windows-server-2025-eval-x64-en-us.iso"
VIRTIO_ISO="virtio-win-0.1.285.iso"

# Openssl-generated CA chain and leaf certs. Never in the repo tree.
PKI_DIR="${HOME}/vms/pki"
